// Board name : ESP32-LyraT-Mini_V1.2
// The above board has two led, 
// Green led to the pin number 22, Blue led to the pin number 27

#define GREEN_LED 22
#define BLUE_LED 27

void setup() {
  pinMode(GREEN_LED, OUTPUT);
  pinMode(BLUE_LED, OUTPUT);
}

void loop() {
  while(1)  // while(1) means the loop runs continuously
  {
  digitalWrite(GREEN_LED, HIGH);  // digitalWrite() is a built-in function used to send an ON or OFF electrical signal to a specific digital pin.
  digitalWrite(BLUE_LED, LOW);
  delay(1000);

  digitalWrite(GREEN_LED, LOW);
  digitalWrite(BLUE_LED, HIGH);
  delay(1000); 
  }
  
}
